{
  "name": "@browserglass/protocol",
  "version": "0.1.0-alpha.0",
  "description": "Every wire type, the binary frame codec, close and error code tables, id generation, the capability enum, and every extension point interface. Zero runtime dependencies; ships to the browser.",
  "keywords": [
    "browserglass",
    "browser",
    "chrome",
    "cdp",
    "remote-browser",
    "websocket",
    "protocol",
    "codec"
  ],
  "homepage": "https://github.com/psmux/browserglass/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/psmux/browserglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmux/browserglass.git",
    "directory": "packages/protocol"
  },
  "license": "Apache-2.0",
  "author": "Godwin Josh",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "browserglass": {
    "layer": 0
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node ../../scripts/guard-publisher.mjs"
  }
}
