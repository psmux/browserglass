{
  "name": "@browserglass/server",
  "version": "0.1.0-alpha.0",
  "description": "Transport gateway: createBrowserGlass(), the WebSocket protocol loop, JWT auth, capability enforcement, and the framework adapters.",
  "keywords": [
    "browserglass",
    "browser",
    "chrome",
    "cdp",
    "remote-browser",
    "websocket",
    "gateway",
    "server"
  ],
  "homepage": "https://github.com/psmux/browserglass/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/psmux/browserglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmux/browserglass.git",
    "directory": "packages/server"
  },
  "license": "Apache-2.0",
  "author": "Godwin Josh",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "browserglass": {
    "layer": 6
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node ../../scripts/guard-publisher.mjs"
  },
  "dependencies": {
    "@browserglass/protocol": "workspace:^",
    "@browserglass/core": "workspace:^",
    "@browserglass/router": "workspace:^",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@browserglass/runtime-host": "workspace:^",
    "@browserglass/store-sqlite": "workspace:^",
    "@hono/node-server": "^2.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.5.13",
    "express": "^4.21.2",
    "fastify": "^5.12.1",
    "hono": "^4.13.3",
    "next": "^15.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
