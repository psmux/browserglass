{
  "name": "@browserglass/embed",
  "version": "0.1.0-alpha.0",
  "description": "<browser-glass>, a self-contained custom element for embedding a live BrowserGlass pane in any HTML page with one script tag. No React, no bundler.",
  "keywords": [
    "browserglass",
    "browser",
    "chrome",
    "cdp",
    "remote-browser",
    "web-components",
    "custom-element"
  ],
  "homepage": "https://github.com/psmux/browserglass/tree/main/packages/embed#readme",
  "bugs": {
    "url": "https://github.com/psmux/browserglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmux/browserglass.git",
    "directory": "packages/embed"
  },
  "license": "Apache-2.0",
  "author": "Godwin Josh",
  "type": "module",
  "sideEffects": true,
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "browserglass": {
    "layer": null
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node ../../scripts/guard-publisher.mjs"
  },
  "dependencies": {
    "@browserglass/protocol": "workspace:^",
    "@browserglass/client": "workspace:^"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
