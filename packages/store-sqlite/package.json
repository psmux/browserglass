{
  "name": "@browserglass/store-sqlite",
  "version": "0.1.0-alpha.0",
  "description": "The complete persistence schema, the migration runner, and every Store method, on SQLite.",
  "keywords": [
    "browserglass",
    "browser",
    "chrome",
    "cdp",
    "remote-browser",
    "sqlite",
    "persistence",
    "store"
  ],
  "homepage": "https://github.com/psmux/browserglass/tree/main/packages/store-sqlite#readme",
  "bugs": {
    "url": "https://github.com/psmux/browserglass/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmux/browserglass.git",
    "directory": "packages/store-sqlite"
  },
  "license": "Apache-2.0",
  "author": "Godwin Josh",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "migrations", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "browserglass": {
    "layer": 1
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "node ../../scripts/guard-publisher.mjs"
  },
  "dependencies": {
    "@browserglass/protocol": "workspace:^",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7"
  }
}
